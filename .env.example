NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Armazenamento de fotos: 'supabase' (PADRÃO — sem esta var, é este), 'drive' (Google
# Drive) ou 'r2' (Cloudflare R2). 'drive' e 'r2' exigem as credenciais abaixo.
FOTOS_STORAGE=supabase
# Credenciais do Cloudflare R2 (bucket privado) — server-only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Google Drive (quando FOTOS_STORAGE=drive) — server-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# SSO do Portal RwTech (formularios.rwtech.com.br) — opcional.
# Sem estas duas, o /sso responde 503 e o resto da aplicação segue normal.
# O segredo é compartilhado com o portal e NUNCA vai pro repositório.
RWTECH_SSO_SECRET=
RWTECH_SITE_ID=

# Alertas de taxa de aprovação (Telegram/Discord) — server-only.
# Sem os tokens, o canal aparece como "não configurado" e nada é enviado.
# Passo a passo de criação dos bots: tools/alertas/README.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_CONVITE_URL=
# Canal do Discord onde as regras com "avisar no canal" postam (id do canal; o bot precisa de
# "Ver canal" e "Enviar mensagens" nele). Vazia = nenhuma regra avisa em canal, só no privado.
DISCORD_CANAL_ID=
# Segredo do crontab que chama POST /api/alertas/avaliar a cada 5 minutos
ALERTAS_CRON_SECRET=

# Lançamento escondido dos Alertas: e-mails liberados a ver/acessar as telas (separados por
# vírgula), sem diferenciar maiúsculas e com trim; '*' = todos (é assim que se libera de vez).
# VAZIA OU AUSENTE = NINGUÉM, pra um deploy sem a variável não expor a tela. As rotas /api/alertas/* (cron e webhooks) nunca
# são bloqueadas por esta variável.
ALERTAS_LIBERADO_PARA=

# Fluxo da OP embutido no Dashboard Enterplak (rotas /embed/*) — server-only.
# Sem DASHBOARD_SSO_SECRET/DASHBOARD_SSO_EMAIL o /embed/sso responde 503 e o resto da
# aplicação segue normal. Os segredos são compartilhados com o Dashboard e NUNCA vão pro
# repositório (gere com `openssl rand -base64 48`).
DASHBOARD_SSO_SECRET=
# Conta compartilhada (somente leitura) que entra por SSO; qualquer outro e-mail → 403.
# Procedimento de criação: docs/operacao/conta-dashboard-sso.md
DASHBOARD_SSO_EMAIL=conta-do-dashboard@exemplo.com.br
# Bearer da GET /api/dashboard/ops-ativas (lista de OPs em andamento pro Dashboard).
DASHBOARD_API_SECRET=
# Origem do Dashboard: alvo do postMessage e padrão do frame-ancestors do /embed.
DASHBOARD_ORIGIN=https://dashboard.exemplo.com.br
# Quem pode embutir o /embed em iframe (sobrepõe DASHBOARD_ORIGIN; separe por espaço pra
# incluir preview/dev). Vazia = cai no DASHBOARD_ORIGIN; as duas vazias = ninguém embute.
EMBED_FRAME_ANCESTORS=
# ⚠️ DASHBOARD_ORIGIN e EMBED_FRAME_ANCESTORS são lidas NO BUILD do Next (o `headers()` do
# next.config.ts é avaliado ali). Entrar com elas depois do build deixa o CSP em
# `frame-ancestors 'self'` e o iframe bloqueado, SEM ERRO NENHUM nos logs — só a moldura
# vazia no Dashboard. Mudou a variável → novo build/deploy.

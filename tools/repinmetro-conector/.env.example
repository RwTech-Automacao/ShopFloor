# Copie para .env e preencha. NUNCA comitar o .env (já está no .gitignore por `.env*`).

# --- Supabase do ShopFloor (destino) ---
# URL do projeto (Dev pro teste; Prod quando for pra valer).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key — fica SÓ nesta máquina, nunca no repo/Vercel.
SUPABASE_SERVICE_ROLE=chave-service-role

# --- repinmetro (origem, Postgres na própria máquina) ---
REPINMETRO_HOST=localhost
REPINMETRO_PORT=5432
REPINMETRO_DB=nome-do-banco
REPINMETRO_USER=shopfloor_ro
REPINMETRO_PASSWORD=senha-do-usuario-readonly

# --- Opcionais ---
# Tamanho do lote por rodada (default 1000).
REPINMETRO_LOTE=1000
# Só usado quando repinmetro_logs está VAZIO (1ª vez):
#   - deixe em branco = baseline no MAX(teste.id) atual (sem backfill; "só daqui pra frente")
#   - REPINMETRO_SINCE=0 = puxa TODO o histórico (útil pro Teste A, ver README)
#   - REPINMETRO_SINCE=12345 = começa logo após esse id
REPINMETRO_SINCE=

# --- Revenda de cada REP (tela REPs/Revendas) ---
# 1 = a cada rodada, recarrega a revenda de todos os REPs em repinmetro_revendas (migração 0107).
# Só ligue depois que o usuário acima tiver SELECT na view (senão essa parte falha; os testes seguem).
REPINMETRO_REVENDA=
# View no banco do repinmetro com numeroserierep, datahora, datahorasaidaexpedicao, razaosocial
# (sem a chave criptográfica). Default: vw_shopfloor_rep_revenda
REPINMETRO_REVENDA_VIEW=
